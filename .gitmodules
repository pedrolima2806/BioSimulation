[submodule "vendored/SDL"]
	path = vendored/SDL
	url = https://github.com/libsdl-org/SDL.git
[submodule "vendored/SDL_image"]
	path = vendored/SDL_image
	url = https://github.com/libsdl-org/SDL_image.git
[submodule "vendored/vendored/SDL_mixer"]
	path = vendored/vendored/SDL_mixer
	url = https://github.com/libsdl-org/SDL_mixer.git
[submodule "vendored/vendored/SDL_ttf"]
	path = vendored/vendored/SDL_ttf
	url = https://github.com/libsdl-org/SDL_ttf.git
